---
import { siteData } from '../data/siteData';
import Reveal from './react/Reveal.tsx';
---
<Reveal client:visible className="glass p-7 sm:p-9">
  <div class="grid gap-8 md:grid-cols-[1.5fr_1fr]">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.12em] text-muted">// summary</p>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-text/90">{siteData.summary}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {siteData.focusAreas.map((f) => (
          <span class="rounded-full border border-line bg-white/[0.04] px-3 py-1 font-mono text-xs text-muted">{f}</span>
        ))}
      </div>
    </div>
    <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 md:grid-cols-1">
      {siteData.aboutFacts.map((f) => (
        <div class="border-l border-line pl-4">
          <dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted">{f.k}</dt>
          <dd class="mt-1 text-sm text-text">{f.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</Reveal>
