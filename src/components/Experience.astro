---
import { siteData } from '../data/siteData';
import Reveal from './react/Reveal.tsx';
---
<div class="flex flex-col gap-4">
  {siteData.experience.map((x, i) => (
    <Reveal client:visible delay={i * 0.06} className="glass p-6 sm:p-7">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <h3 class="text-lg font-semibold tracking-tight">{x.role}</h3>
        <span class="flex items-center gap-2 font-mono text-xs text-muted">
          {x.current && <span class="h-1.5 w-1.5 rounded-full bg-success" style="box-shadow:0 0 8px #22c55e"></span>}
          {x.period}
        </span>
      </div>
      <p class="mt-1 font-mono text-xs text-primary">{x.org}</p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{x.note}</p>
    </Reveal>
  ))}
</div>

<h3 class="mb-4 mt-12 font-mono text-xs uppercase tracking-[0.12em] text-muted">// education</h3>
<div class="grid gap-4 sm:grid-cols-2">
  {siteData.education.map((e, i) => (
    <Reveal client:visible delay={i * 0.06} className="glass p-6">
      <div class="flex items-baseline justify-between gap-3">
        <h4 class="font-semibold tracking-tight">{e.degree}</h4>
        <span class="shrink-0 font-mono text-xs text-muted">{e.period}</span>
      </div>
      <p class="mt-1 font-mono text-xs text-primary">{e.school}</p>
      <p class="mt-2 text-sm text-muted">{e.note}</p>
    </Reveal>
  ))}
</div>
