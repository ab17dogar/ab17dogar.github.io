---
// Build-time sync of public GitHub repositories. Re-fetches on every deploy.
// Resilient: falls back to a curated list if the API is unreachable / rate-limited.
const USER = 'ab17dogar';
const token = process.env.GITHUB_TOKEN; // provided in CI for a higher rate limit; optional locally

interface Repo {
  name: string; description: string | null; url: string;
  language: string | null; stars: number; topics: string[]; updated: string;
}

let repos: Repo[] = [];
try {
  const res = await fetch(`https://api.github.com/users/${USER}/repos?per_page=100&sort=updated`, {
    headers: {
      Accept: 'application/vnd.github+json',
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    },
  });
  if (res.ok) {
    const data: any[] = await res.json();
    repos = data
      .filter((r) => !r.fork && r.name !== USER) // drop forks + the profile-README repo
      .map((r) => ({
        name: r.name,
        description: r.description,
        url: r.html_url,
        language: r.language,
        stars: r.stargazers_count ?? 0,
        topics: r.topics ?? [],
        updated: r.pushed_at ?? '',
      }))
      .sort((a, b) => (b.stars - a.stars) || (Date.parse(b.updated) - Date.parse(a.updated)));
  }
} catch {
  /* fall through to fallback below */
}

if (repos.length === 0) {
  repos = [
    { name: 'rgbd-scene-graph', description: 'Semantic 3D scene graphs from egocentric RGB-D with BIM/IFC priors.', url: 'https://github.com/ab17dogar/rgbd-scene-graph', language: 'Python', stars: 0, topics: ['computer-vision', 'bim', '3d-scene-graph'], updated: '' },
    { name: 'Project-CSI', description: '3D ray tracing engine (VetraPath).', url: 'https://github.com/ab17dogar/Project-CSI', language: 'C++', stars: 0, topics: ['graphics', 'raytracer', 'cpp'], updated: '' },
    { name: 'ab17dogar.github.io', description: 'This portfolio — Astro + React + Tailwind.', url: 'https://github.com/ab17dogar/ab17dogar.github.io', language: 'Astro', stars: 0, topics: [], updated: '' },
  ];
}

const fmt = (d: string) => (d ? new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : '');
---
<div>
  <div class="mb-4 mt-12 flex items-baseline justify-between">
    <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-muted">// all repositories · synced from github</h3>
    <a href={`https://github.com/${USER}`} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-muted transition-colors hover:text-text">@{USER} →</a>
  </div>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {repos.map((r) => (
      <a
        href={r.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-xl border border-line bg-white/[0.03] p-5 transition-colors hover:border-primary/40"
      >
        <div class="flex items-center justify-between gap-3">
          <span class="flex items-center gap-2 font-semibold tracking-tight">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="text-muted"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            {r.name}
          </span>
          <span class="shrink-0 font-mono text-xs text-muted opacity-0 transition-opacity group-hover:opacity-100">open →</span>
        </div>
        {r.description && <p class="mt-2 text-sm leading-relaxed text-muted">{r.description}</p>}
        <div class="mt-3 flex flex-wrap items-center gap-3 font-mono text-[11px] text-muted">
          {r.language && (
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-primary"></span>{r.language}</span>
          )}
          {r.stars > 0 && <span>★ {r.stars}</span>}
          {r.updated && <span>updated {fmt(r.updated)}</span>}
        </div>
        {r.topics.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {r.topics.slice(0, 4).map((t) => (
              <span class="rounded-full border border-line px-2 py-0.5 font-mono text-[10px] text-muted">{t}</span>
            ))}
          </div>
        )}
      </a>
    ))}
  </div>
</div>
