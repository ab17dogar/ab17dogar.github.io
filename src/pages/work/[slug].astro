---
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGithubProjects } from '../../lib/github-projects';

export async function getStaticPaths() {
  const projects = await getGithubProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const bodyHtml = project.body ? (marked.parse(project.body) as string) : '';
---
<BaseLayout title={project.title} description={project.summary}>
  <article class="py-14">
    <a href="/#projects" class="inline-flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 font-mono text-xs text-muted transition-colors hover:border-primary/40 hover:text-text">
      ← Back to projects
    </a>
    <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.14em] text-primary">// {project.tags.join(' · ')}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">{project.title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">{project.summary}</p>

    {project.stack.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-1.5">
        {project.stack.map((s) => (
          <span class="rounded border border-line bg-white/[0.06] px-2 py-0.5 font-mono text-[10px] text-muted">{s}</span>
        ))}
      </div>
    )}

    <div class="mt-6 flex flex-wrap gap-3">
      <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-primary/40 bg-primary/15 px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary/25">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        Go to GitHub repo →
      </a>
      {project.demo && (
        <a href={project.demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm font-medium text-muted transition-colors hover:border-primary/40 hover:text-text">
          Live demo →
        </a>
      )}
    </div>

    {bodyHtml && <div class="prose-portfolio mt-10 max-w-2xl" set:html={bodyHtml} />}
  </article>
</BaseLayout>
